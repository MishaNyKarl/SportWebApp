# Скопируй в .env на сервере и заполни реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore).

DJANGO_SECRET_KEY=замени-на-сгенерированный-ключ
DJANGO_DEBUG=False
# IP сервера и/или домен(ы) через запятую, например: 169.255.57.42,sportapp.example.com
DJANGO_ALLOWED_HOSTS=169.255.57.42
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_SSL_REDIRECT=False

POSTGRES_DB=sportapp
POSTGRES_USER=sportapp
POSTGRES_PASSWORD=замени-на-надёжный-пароль
POSTGRES_HOST=db
POSTGRES_PORT=5432
